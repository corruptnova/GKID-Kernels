# Security hardening on top of stock GKI (which already has CFI, SCS,
# init_on_alloc, auto-var-init, FORTIFY, UBSAN trap, KFENCE, ...).
# Only options that flip a runtime default or change code generation:
# none of them alter exported types, so the KMI stays intact.
# Symbols missing on older lines (e.g. 5.10) are ignored by Kconfig.

# Zero heap memory on free (limits use-after-free / info leaks)
CONFIG_INIT_ON_FREE_DEFAULT_ON=y

# Randomize kernel stack offset on every syscall (5.15+)
CONFIG_RANDOMIZE_KSTACK_OFFSET_DEFAULT=y

# Zero caller-used registers on function return, hinders ROP (5.15+)
CONFIG_ZERO_CALL_USED_REGS=y
